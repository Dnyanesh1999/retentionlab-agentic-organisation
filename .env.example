# Browser-safe public API origin. Never place provider credentials in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3000

# Server-only. Never prefix these values with VITE_ or expose them to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_EVIDENCE_FUNCTION=retentionlab-evidence
DEMO_DATA_SEED=20260805

# Gate 4 server-only agent runtime. openrouter/free keeps student/demo runs at zero model cost.
OPENROUTER_API_KEY=
OPENROUTER_RESEARCHER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DESIGNER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
