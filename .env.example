# Browser-safe public API origin. Never place provider credentials in VITE_* variables.
VITE_API_BASE_URL=http://localhost:3000

# Browser-safe Supabase values for the read-only fictional evidence gateway.
# Publishable keys are public identifiers; never substitute a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_EVIDENCE_FUNCTION=retentionlab-evidence

# Server-runtime names used by the MCP gateway. The publishable value may match its public Vite
# counterpart; the secret key must never use a VITE_ prefix or be exposed to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_EVIDENCE_FUNCTION=retentionlab-evidence
DEMO_DATA_SEED=20260805

# Gate 4 server-only agent runtime. openrouter/free keeps student/demo runs at zero model cost.
OPENROUTER_API_KEY=
OPENROUTER_RESEARCHER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_DESIGNER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
