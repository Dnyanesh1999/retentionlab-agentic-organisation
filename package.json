{
  "name": "retentionlab-agentic-organisation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "mcp:dev": "node --env-file-if-exists=.env.local --import tsx mcp/stdio.ts",
    "mcp:start": "node --env-file-if-exists=.env.local dist-mcp/stdio.js",
    "mcp:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/mcp-live-smoke.ts",
    "preflight": "node --env-file-if-exists=.env.local --import tsx ops/preflightCli.ts",
    "preflight:all": "node --env-file-if-exists=.env.local --import tsx ops/preflightCli.ts --scope=all",
    "agent:researcher": "node --env-file-if-exists=.env.local --import tsx agents/researcher/cli.ts",
    "agent:researcher:check": "tsc -p tsconfig.agents.json --pretty false",
    "agent:designer": "node --env-file-if-exists=.env.local --import tsx agents/designer/cli.ts",
    "agent:designer:promote": "node --env-file-if-exists=.env.local --import tsx agents/designer/reviewCli.ts",
    "agent:maker": "node --env-file-if-exists=.env.local --import tsx agents/maker/cli.ts",
    "agent:communicator": "node --env-file-if-exists=.env.local --import tsx agents/communicator/cli.ts",
    "agent:manager": "node --env-file-if-exists=.env.local --import tsx agents/manager/cli.ts",
    "agent:manager:check": "tsc -p tsconfig.agents.json --pretty false",
    "agent:pipeline": "node --env-file-if-exists=.env.local --import tsx agents/orchestrator/pipelineCli.ts",
    "agent:pipeline:check": "tsc -p tsconfig.agents.json --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:data": "node --test scripts/generate-demo-data.node-test.mjs",
    "test:release": "node --test scripts/release/secret-scan.node-test.mjs scripts/release/static-audit.node-test.mjs scripts/build-assistant-corpus.node-test.mjs scripts/release/ai-usage-appendix.node-test.mjs scripts/release/code-zip-contents.node-test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "data:generate": "node scripts/generate-demo-data.mjs",
    "release:scan": "node scripts/release/scan-repo.mjs",
    "release:zip": "node scripts/release/package-code-zip.mjs",
    "release:pages": "node scripts/release/check-pages-build.mjs",
    "release:ai-appendix": "node scripts/release/build-ai-usage-appendix.mjs",
    "release:check": "node scripts/release/run-release-checks.mjs",
    "assistant:corpus": "node scripts/build-assistant-corpus.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@openrouter/sdk": "0.13.67",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "tsx": "4.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
